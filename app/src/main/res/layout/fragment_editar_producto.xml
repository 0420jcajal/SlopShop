<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainEditar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="30dp"
    tools:context=".Administrador.Productos.FragmentEditarProducto">


    <RelativeLayout
        android:id="@+id/RLTituloEditar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:text="Editar Producto"
            android:layout_centerInParent="true"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:textSize="30sp"
            android:fontFamily="@font/handwrite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="#ccc"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/RLTituloEditar"
        app:layout_constraintBottom_toTopOf="@id/btnGuardarCambios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imagenProductoEditar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="5dp"
                android:layout_centerHorizontal="true"
                android:scaleType="centerCrop"
                android:contentDescription="Imagen producto"
                android:src="@drawable/icono_producto" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TILNombreProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_below="@id/imagenProductoEditar">

                <EditText
                    android:id="@+id/etNombreProducto"
                    android:hint="Nombre del producto"
                    android:inputType="textCapSentences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/categoria"
                android:layout_below="@id/TILNombreProducto"
                android:hint="Categoría"
                android:padding="15dp"
                android:textSize="17sp"
                android:gravity="center_vertical"
                android:background="@drawable/custom_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:drawableEndCompat="@drawable/icono_desplegar"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TILDescripcionProducto"
                android:layout_below="@+id/categoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">

                <EditText
                    android:id="@+id/etDescripcionProducto"
                    android:hint="Descripción"
                    android:inputType="textCapSentences|textMultiLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>


            <LinearLayout
                android:id="@+id/layoutPrecioYEliminar"
                android:layout_below="@id/TILDescripcionProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="5dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/TILPrecioP"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="100dp"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etPrecioProducto"
                        android:hint="Precio"
                        android:inputType="numberDecimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEliminar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:padding="10dp"
                    android:textSize="14sp"
                    app:backgroundTint="@color/rojo"
                    app:icon="@drawable/icono_borrar_xml"
                    android:layout_marginEnd="5dp"
                    app:iconSize="40dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/decSwitch"
                android:text="¿Descuento?"
                android:layout_below="@id/layoutPrecioYEliminar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TILPrecioDescuentoProducto"
                android:layout_below="@id/decSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">

                <EditText
                    android:id="@+id/etPrecioConDescuentoProducto"
                    android:hint="Precio con descuento"
                    android:inputType="numberDecimal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TILNotaAyudaDesc"
                android:layout_below="@id/TILPrecioDescuentoProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">

                <EditText
                    android:id="@+id/ejemploDescuento"
                    android:hint="Ejemplo de descuento (e.g. 20% OFF)"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarCambios"
        android:text="Guardar Cambios"
        android:textAllCaps="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
