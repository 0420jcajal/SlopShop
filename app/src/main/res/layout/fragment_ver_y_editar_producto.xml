<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <TextView
            android:id="@+id/tituloProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Producto"
            android:textSize="40sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/handwrite"/>

        <ImageView
            android:id="@+id/imagenPrincipalProducto"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:layout_below="@id/tituloProducto"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImagenesProducto"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_below="@id/imagenPrincipalProducto"
            android:layout_marginTop="16dp"
            android:padding="5dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />

        <TextView
            android:id="@+id/txtCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rvImagenesProducto"
            android:layout_marginTop="10dp"
            android:padding="5dp"
            android:text="Categoría: Categoria del Producto"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtCategoria"
            android:layout_marginTop="8dp"
            android:padding="5dp"
            android:text="Descripcion del producto \nY\nDetalles"
            android:textSize="16sp" />



            <TextView
                android:id="@+id/txtPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="5dp"
                android:text="Precio: 125.75€"
                android:layout_below="@id/txtDescripcion"
                android:textStyle="bold"
                android:textSize="16sp" />

        <RelativeLayout
            android:id="@+id/rlPreciosYEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtPrecio"


>
            <TextView
                android:id="@+id/txtPrecioDescuento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Precio Descuento: 99.99€"
                android:textStyle="bold"
                android:textSize="22sp"
                android:padding="5dp"
                android:textColor="@android:color/holo_red_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/icono_editar"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:iconSize="32dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart" />

            <TextView
                android:id="@+id/txtEjemploDescuento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtPrecioDescuento"
                android:layout_marginTop="8dp"
                android:text="20% Descuento"
                android:textStyle="italic"
                android:padding="5dp"
                android:textSize="14sp" />

        </RelativeLayout>



        <TextView
            android:id="@+id/txtRating"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rlPreciosYEditar"
            android:layout_marginTop="8dp"
            android:text="Puntuacion: ★★★★☆"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccionProducto"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Comentarios"
            android:layout_below="@id/txtRating"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>


    </RelativeLayout>
</ScrollView>